# Godot 4+ specific ignores
.godot/
/android/

# Local agent/session metadata
/.zcode/

# 本地产物不入库：Assets/（美术原图 + 资源定义）与 maps/（编辑器产出的地图）
# 两个目录本身用 .gitkeep 占位保留，换机/克隆后需要自行回填内容
/Assets/*
!/Assets/.gitkeep
# 例外：资产系统的运行时脚本是代码不是美术资源，必须进版本库；
# 同目录的 catalog.tres / defs/*.tres 仍然排除（保存着手工调好的 art_size/lift/offset）
!/Assets/static_assets/
/Assets/static_assets/*
!/Assets/static_assets/*.gd
!/Assets/static_assets/*.uid
/maps/*
!/maps/.gitkeep

# 预览图仅供 README 引用，Godot 的导入缓存不入库
/demos/preview/*.import

__pycache__/
*.pyc

# 个人美术资料：仅本地保留（备份在 ../GridAtlas_private_backup），不进入仓库
/Docs/2D资产风格管线/截图/
/Docs/2D资产风格管线/参考/
/GridData/
