[gd_scene load_steps=5 format=3]

[ext_resource type="Script" uid="uid://ckqta3jiubuv4" path="res://editor/props_tool.gd" id="1_props"]
[ext_resource type="PackedScene" path="res://editor/ui/fold_section.tscn" id="2_fold"]

[sub_resource type="ButtonGroup" id="ButtonGroup_asset"]

[sub_resource type="ButtonGroup" id="ButtonGroup_rotation"]

[node name="PropsTool" type="VBoxContainer"]
theme_override_constants/separation = 8
script = ExtResource("1_props")
asset_group = SubResource("ButtonGroup_asset")

[node name="SectionMain" parent="." instance=ExtResource("2_fold")]
layout_mode = 2
section_title = "静态"
start_folded = true

[node name="AssetTitleRow" type="HBoxContainer" parent="SectionMain/VBox/Content/Body"]
layout_mode = 2

[node name="AssetTitle" type="Label" parent="SectionMain/VBox/Content/Body/AssetTitleRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = "Dim"
vertical_alignment = 1
text = "资源库（按类型）"

[node name="AssetRefresh" type="Button" parent="SectionMain/VBox/Content/Body/AssetTitleRow"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
tooltip_text = "重新读取 Assets/static_assets 下的资源定义"
text = "刷新"

[node name="AssetEdit" type="Button" parent="SectionMain/VBox/Content/Body/AssetTitleRow"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
tooltip_text = "打开资源导入页：新建 / 导入 PNG / 编辑占地范围与阻挡格"
text = "编辑"

[node name="RotationRow" type="HBoxContainer" parent="SectionMain/VBox/Content/Body"]
layout_mode = 2

[node name="RotationTitle" type="Label" parent="SectionMain/VBox/Content/Body/RotationRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = "Dim"
vertical_alignment = 1
text = "待放方向"

[node name="Rot0" type="Button" parent="SectionMain/VBox/Content/Body/RotationRow"]
custom_minimum_size = Vector2(64, 26)
layout_mode = 2
toggle_mode = true
button_group = SubResource("ButtonGroup_rotation")
tooltip_text = "横向：原始占地与图片（0°）"
text = "横向"

[node name="Rot90" type="Button" parent="SectionMain/VBox/Content/Body/RotationRow"]
custom_minimum_size = Vector2(64, 26)
layout_mode = 2
toggle_mode = true
button_group = SubResource("ButtonGroup_rotation")
tooltip_text = "竖向：占地交换宽高，图片水平镜像（90°）"
text = "竖向"

[node name="Selected" type="Label" parent="SectionMain/VBox/Content/Body"]
layout_mode = 2
clip_text = true
text = "当前：无"

[node name="Count" type="Label" parent="SectionMain/VBox/Content/Body"]
layout_mode = 2
theme_type_variation = "Dim"
text = "静态 0 个"

[node name="Clear" type="Button" parent="SectionMain/VBox/Content/Body"]
layout_mode = 2
text = "清除全部"

[node name="SectionLocal" parent="." instance=ExtResource("2_fold")]
layout_mode = 2
visible = false
section_title = "本图热点"

[node name="Flow" type="HFlowContainer" parent="SectionLocal/VBox/Content/Body"]
layout_mode = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6

[node name="SectionGlobal" parent="." instance=ExtResource("2_fold")]
layout_mode = 2
section_title = "全局库"

[node name="AssetEmpty" type="Label" parent="SectionGlobal/VBox/Content/Body"]
layout_mode = 2
theme_type_variation = "Dim"
